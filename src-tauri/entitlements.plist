<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      GhostWriter cannot run under App Sandbox.

      The previous version of this file set com.apple.security.app-sandbox to
      true. That had no effect only because unsigned builds skip codesigning
      entirely; the day this app is signed with a real identity, a sandboxed
      GhostWriter would be unable to:

        - post synthetic keyboard events into other applications (enigo),
          which is the entire point of the app
        - spawn and pkill the external GhostWriterOverlayHelper process
        - bind the Unix domain socket the HUD protocol runs over
        - write the debug WAV to ~/Desktop

      It also declared com.apple.security.accessibility, which is not a real
      entitlement key — Accessibility is granted through TCC at runtime, not
      claimed in an entitlements file.

      Distribution therefore means Developer ID + notarization, not the Mac
      App Store.
    -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Microphone capture for dictation. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- osascript is used for the auto-mute feature. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
